{
  "name": "@local/dsh-browser-bridge",
  "version": "1.8.0",
  "private": true,
  "description": "Bridge DSH tools to a web AI chat page in the user's already-running Chrome over CDP.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "Start-Browser-Bridge.cmd",
    "scripts/*.ps1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
